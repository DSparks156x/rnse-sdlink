static __attribute__((noinline)) void btc2_block(rnv_u8 *d, const rnv_s32 *c, const rnv_u8 *m)
{
    rnv_u32 T[4]; int r;
    rnv_u32 Ca = LAT_CW(c[2], c[4]), Cb = LAT_CW(c[3], c[5]), Cm = LV_U(Ca, Cb);
    T[0] = LAT_YW(c[0]) | Ca; T[3] = LAT_YW(c[1]) | Cb;
    T[1] = ((rnv_u32)c[0] << 24) | ((rnv_u32)c[1] << 8) | Cm; T[2] = ((rnv_u32)c[1] << 24) | ((rnv_u32)c[0] << 8) | Cm;
    _Pragma("GCC unroll 8") for (r = 0; r < 8; r++, d += S) {
        rnv_u32 v = m[r];
        STW(d, T[v >> 6]); STW(d + 4, T[(v >> 4) & 3]); STW(d + 8, T[(v >> 2) & 3]); STW(d + 12, T[v & 3]);
    }
}
static __attribute__((noinline)) void btc4_block(rnv_u8 *d, const rnv_s32 *c, const rnv_u8 *m)
{
    rnv_u32 T[16], Cw[7]; int r, i, j;
    int y0 = c[0], y3 = c[1], Y[4];
    Y[0] = y0; Y[3] = y3; Y[1] = (5 * y0 + 3 * y3 + 4) >> 3; Y[2] = (3 * y0 + 5 * y3 + 4) >> 3;
    {
        int u0 = c[2], u3 = c[3], v0 = c[4], v3 = c[5];
        Cw[0] = LAT_CW(u0, v0); Cw[6] = LAT_CW(u3, v3);
        Cw[1] = LAT_CW((7 * u0 + u3 + 4) >> 3, (7 * v0 + v3 + 4) >> 3); Cw[2] = LAT_CW((5 * u0 + 3 * u3 + 4) >> 3, (5 * v0 + 3 * v3 + 4) >> 3);
        Cw[3] = LAT_CW((u0 + u3 + 1) >> 1, (v0 + v3 + 1) >> 1); Cw[4] = LAT_CW((3 * u0 + 5 * u3 + 4) >> 3, (3 * v0 + 5 * v3 + 4) >> 3);
        Cw[5] = LAT_CW((u0 + 7 * u3 + 4) >> 3, (v0 + 7 * v3 + 4) >> 3);
    }
    _Pragma("GCC unroll 4") for (i = 0; i < 4; i++) _Pragma("GCC unroll 4") for (j = 0; j < 4; j++) T[i << 2 | j] = ((rnv_u32)Y[i] << 24) | ((rnv_u32)Y[j] << 8) | Cw[i + j];
    _Pragma("GCC unroll 8") for (r = 0; r < 8; r++, d += S, m += 2) {
        rnv_u32 a = m[0], b = m[1];
        STW(d, T[a >> 4]); STW(d + 4, T[a & 15]); STW(d + 8, T[b >> 4]); STW(d + 12, T[b & 15]);
    }
}
