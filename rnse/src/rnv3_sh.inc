/* RNV3 block modes on the SH-4A: word arithmetic, straight to the frame.  Same pixels as src/rnv3_modes.h (checked on the host against dec/rnv3dec.c).  Included by rnv2sh.c in the RNV_FAST build.
 * Rows 0, 4, 8 are built; one column of the block then costs 6 word averages and 8 stores. */
#define LV_U(a, b) (((a) | (b)) - ((((a) ^ (b)) >> 1) & 0x7F7F7F7Fu))
#define LV_D(a, b) (((a) & (b)) + (((a) ^ (b)) >> 1 & 0x7F7F7F7Fu))
#define LAT_CW(cb, cr) (((rnv_u32)(cb) << 16) | (rnv_u32)(cr))
