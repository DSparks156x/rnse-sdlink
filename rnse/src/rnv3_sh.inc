static __attribute__((noinline)) rnv_s32 se_slow(const rnv_u8 *w, rnv_u32 *pp, int *bad) { return se(w, pp, bad); }
AI void r3w_load(r3win *W, const rnv_u8 *w, rnv_u32 p)
{
