/* LAT_DITH {{0,2},{3,1}}: even rows Y0 +0, Y1 +2; odd rows Y0 +3, Y1 +1 */
#define DW0 0x00000200u
#define DW1 0x03000100u
AI void lat_col(rnv_u8 *d, rnv_u32 a, rnv_u32 c, rnv_u32 e, const rnv_u32 D0, const rnv_u32 D1)
{   /* rows 0,1 = a; 2,3 = avg down (a,c); 4,5 = c; 6,7 = avg down (c,e); even rows + D0, odd rows + D1 */
    rnv_u32 b = LV_D(a, c), f = LV_D(c, e);
    STW(d, a + D0); d += S; STW(d, a + D1); d += S;
    STW(d, b + D0); d += S; STW(d, b + D1); d += S;
    STW(d, c + D0); d += S; STW(d, c + D1); d += S;
    STW(d, f + D0); d += S; STW(d, f + D1);
}
AI void lat8_body(rnv_u8 *d, rnv_u32 P0, rnv_u32 P1, rnv_u32 P2, rnv_u32 P3, const rnv_u32 D0, const rnv_u32 D1)
{
