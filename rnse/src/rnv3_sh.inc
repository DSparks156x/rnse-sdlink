    rnv_u32 m0 = LV_D(P0, P1), m4 = LV_D(Ma, Me), m8 = LV_D(P2, P3);
    lat_col(d, P0, Ma, P2, D0, D1);
    { rnv_u32 x0 = LV_U(P0, m0), x4 = LV_U(Ma, m4), x8 = LV_U(P2, m8); lat_col(d + 4, x0, x4, x8, D0, D1); }
    lat_col(d + 8, m0, m4, m8, D0, D1);
    { rnv_u32 x0 = LV_U(m0, P1), x4 = LV_U(m4, Me), x8 = LV_U(m8, P3); lat_col(d + 12, x0, x4, x8, D0, D1); }
}
/* separate copies for dither off / on, so the row offsets are constants and no add is spent on zero */
static __attribute__((noinline)) void lat8_put_n(rnv_u8 *d, rnv_u32 P0, rnv_u32 P1, rnv_u32 P2, rnv_u32 P3) { lat8_body(d, P0, P1, P2, P3, 0, 0); }
static __attribute__((noinline)) void lat8_put_d(rnv_u8 *d, rnv_u32 P0, rnv_u32 P1, rnv_u32 P2, rnv_u32 P3) { lat8_body(d, P0, P1, P2, P3, DW0, DW1); }
AI void lat4_body(rnv_u8 *d, const rnv_u32 L[3][3], const rnv_u32 D0, const rnv_u32 D1)
{
    rnv_u32 r[3][4];
    int i;
    _Pragma("GCC unroll 3") for (i = 0; i < 3; i++) {
        rnv_u32 a = L[i][0], m = L[i][1], e = L[i][2];
        r[i][0] = a; r[i][1] = LV_U(a, m); r[i][2] = m; r[i][3] = LV_U(m, e);
    }
    _Pragma("GCC unroll 4") for (i = 0; i < 4; i++) lat_col(d + 4 * i, r[0][i], r[1][i], r[2][i], D0, D1);
}
static __attribute__((noinline)) void lat4_put_n(rnv_u8 *d, const rnv_u32 L[3][3]) { lat4_body(d, L, 0, 0); }
static __attribute__((noinline)) void lat4_put_d(rnv_u8 *d, const rnv_u32 L[3][3]) { lat4_body(d, L, DW0, DW1); }
static __attribute__((noinline)) void lat2_put(rnv_u8 *d, const rnv_u32 *G, const rnv_u32 C[3][3])
{   /* G: 25 ints, row by row */
    rnv_u32 cw[5][4];
    int i, k;
    _Pragma("GCC unroll 3") for (i = 0; i < 3; i++) { cw[2 * i][0] = C[i][0]; cw[2 * i][1] = LV_U(C[i][0], C[i][1]); cw[2 * i][2] = C[i][1]; cw[2 * i][3] = LV_U(C[i][1], C[i][2]); }
